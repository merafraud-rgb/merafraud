# ═══════════════════════════════════════════════════════════════════════
# MeraFraud — Ortam Değişkenleri (.env)
# ═══════════════════════════════════════════════════════════════════════
# Bu dosyayı ".env" olarak kopyalayıp (uzantısız, .example'sız) içini
# doldurun. Kod, bu dosyadaki değerleri otomatik okuyacak — tek yerden
# yönetim, dosya dosya arayıp değiştirmeye gerek yok.
#
# Kopyalama:
#   cp .env.example .env      (Mac/Linux)
#   copy .env.example .env    (Windows CMD)
#
# ⚠️ .env dosyasını ASLA GitHub'a yüklemeyin (.gitignore'da zaten hariç
# tutuldu) — içinde gerçek şifreler/anahtarlar olacak.
# ═══════════════════════════════════════════════════════════════════════

# ── Temel ────────────────────────────────────────────────────────────
# Deploy ettikten sonra Render'ın size verdiği adresi buraya yazın.
# Yerelde test ederken değiştirmeyin.
MERAFRAUD_API_BASE=http://localhost:5000/api
FLASK_SECRET_KEY=degistir-bu-rastgele-uzun-bir-metin-olmali

# ── E-posta Gönderimi (şifre sıfırlama, hoşgeldin maili) ──────────────
# Herhangi bir SMTP sağlayıcısı çalışır: Gmail, SendGrid, Postmark,
# Amazon SES, Resend, vb. Boş bırakırsanız sistem "demo modda" kalır —
# şifre sıfırlama token'ı e-posta yerine ekranda gösterilir.
#
# Örnek (Gmail — "Uygulama Şifresi" oluşturmanız gerekir, normal şifre
# çalışmaz: myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=sizin@gmail.com
#   SMTP_PASSWORD=uygulama-sifresi-buraya
#
# Örnek (SendGrid — SMTP_USERNAME her zaman "apikey" yazılır):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USERNAME=apikey
#   SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@merafraud.com
SMTP_FROM_NAME=MeraFraud

# ── WhatsApp Business ───────────────────────────────────────────────
# Kendi WhatsApp Business numaranız, ÜLKE KODU + ALAN KODU + NUMARA,
# başında + veya 0 OLMADAN. Örnek: Türkiye 5xx xxx xx xx numarası için
# 905xxxxxxxxx yazın.
WHATSAPP_NUMBER=905374575844

# ── Ödeme Sağlayıcı (iyzico) ────────────────────────────────────────
# iyzico Merchant panelinden alınır: merchant.iyzipay.com → Ayarlar → API
# Boş bırakırsanız checkout sayfası "demo modda" kalır, gerçek ödeme
# almaz. Önce SANDBOX (test) anahtarlarıyla deneyin, sonra production'a
# geçin.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Shopify Webhook (examples/shopify_webhook_integration.py için) ────
SHOPIFY_WEBHOOK_SECRET=
# ── Admin ────────────────────────────────────────────────────────────
# GET /api/tenants (tüm müşteri listesi) bu anahtarı ister — herkese açık
# olmasın diye. Rastgele, tahmin edilmesi zor bir metin seçin ve aynısını
# Render → Environment sekmesinde ADMIN_API_KEY olarak da girin.
ADMIN_API_KEY=
